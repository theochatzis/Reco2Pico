#!/usr/bin/env python3
"""
Create HTCondor job areas for Reco2Pico cmsRun production.
Usage:
  bdriver -c first_cfg.py --steps steps.json -d DATASET -o JOBDIR -fo DESTINATION
  Add --save-intermediates to retain each step's output.
Logic:
  * run each job in a temporary scratch WORKDIR
  * keep only small bookkeeping files in the persistent job directory
  * validate and propagate the X509 proxy
  * use CMSSW's xrootd tools when available
  * stage out local ROOT output with xrdcp for EOS / root:// destinations
"""
import argparse
import datetime
import json
import math
import os
import shlex
import stat
import sys

from Reco2Pico.PicoProducer.utils.common import *
from Reco2Pico.PicoProducer.utils.das import load_dataset_data, skim_das_jsondump


def _quote(value):
    return shlex.quote(str(value))


def _join_output_path(directory, basename):
    directory = str(directory).rstrip('/')
    return directory + '/' + basename


def load_steps(path, default_cmssw, arch):
    """Resolve follow-up steps against the manifest and submission environment."""
    if path is None:
        return []
    manifest = os.path.abspath(path)
    with open(manifest) as handle:
        entries = json.load(handle)
    if not isinstance(entries, list) or not entries:
        raise ValueError('--steps must contain a non-empty JSON list')
    reserved = {'inputFiles', 'secondaryInputFiles', 'output', 'outputFile',
                'maxEvents', 'skipEvents'}
    steps = []
    for number, entry in enumerate(entries, 2):
        if not isinstance(entry, dict) or set(entry) - {'cfg', 'cmssw', 'args'}:
            raise ValueError('step {}: expected cfg, optional cmssw and args'.format(number))
        cfg = entry.get('cfg')
        area = entry.get('cmssw', default_cmssw)
        if not isinstance(cfg, str) or not cfg or not isinstance(area, str) or not area:
            raise ValueError('step {}: cfg and cmssw must be non-empty paths'.format(number))
        paths = []
        for value in (cfg, area):
            value = os.path.expanduser(os.path.expandvars(value))
            if not os.path.isabs(value):
                value = os.path.join(os.path.dirname(manifest), value)
            paths.append(os.path.abspath(value))
        cfg, area = paths
        if not os.path.isfile(cfg):
            raise ValueError('step {}: missing configuration {}'.format(number, cfg))
        if not os.path.isdir(os.path.join(area, 'src')):
            raise ValueError('step {}: missing CMSSW src directory {}'.format(number, area))
        if not arch or not os.path.isdir(os.path.join(area, '.SCRAM', arch)):
            raise ValueError('step {}: CMSSW area must support {}'.format(number, arch))
        args = entry.get('args', [])
        if not isinstance(args, list) or any(not isinstance(arg, str) for arg in args):
            raise ValueError('step {}: args must be a list of strings'.format(number))
        for arg in args:
            key, separator, value = arg.partition('=')
            if not separator or not key or key in reserved or key.endswith('_load'):
                raise ValueError('step {}: invalid or driver-owned argument {}'.format(number, arg))
        steps.append({'cfg': cfg, 'cmssw': area, 'args': args})
    return steps


def chained_commands(steps, basename, destination, jobdir, save_intermediates, arch):
    """Run each consumer before transferring or deleting its input."""
    lines = []
    previous = 'step1_' + basename
    for number, step in enumerate(steps, 2):
        last = number == len(steps) + 1
        output = basename if last else 'step{}_{}'.format(number, basename)
        report = os.path.join(jobdir, 'logs', 'step{}.xml'.format(number))
        command = ['cmsRun', '-j', report, step['cfg']] + step['args']
        command += ['inputFiles=file:' + previous, 'secondaryInputFiles=',
                    'maxEvents=-1', 'skipEvents=0', 'output=' + output]
        lines += [
            'test -s ' + _quote(previous),
            'echo ' + _quote('[INFO] starting step {}'.format(number)),
            '(',
            # Each subshell starts from the first step's environment.
            'runtime=$(scram runtime -unsh)',
            'eval "$runtime"',
            'cd ' + _quote(os.path.join(step['cmssw'], 'src')),
            'export SCRAM_ARCH=' + _quote(arch),
            'runtime=$(scram runtime -sh)',
            'eval "$runtime"',
            'cd "${WORKDIR}"',
            ' '.join(_quote(arg) for arg in command),
            ')',
            'test -s ' + _quote(output),
        ]
        if save_intermediates:
            lines.append('jme_stageout {} {}'.format(
                _quote(previous), _quote(_join_output_path(destination, previous))))
        else:
            lines.append('rm -- ' + _quote(previous))
        previous = output
    lines.append('jme_stageout {} {}'.format(
        _quote(previous), _quote(_join_output_path(destination, previous))))
    return [[line] for line in lines]


def _is_forbidden_condor_submit_path(path):
    """Return True for paths that standard CERN batch schedds reject in submit files."""
    path = str(path)
    return path.startswith('/eos/') or path.startswith('/store/') or path.startswith('root://')


def _sanitize_path_fragment(path):
    """Turn an absolute path into a safe single directory name."""
    path = str(path).strip().strip('/')
    if not path:
        return 'jobs'
    safe_chars = []
    for char in path:
        if char.isalnum() or char in ('-', '_', '.'):
            safe_chars.append(char)
        else:
            safe_chars.append('_')
    return ''.join(safe_chars)


def _default_condor_workdir():
    """Default non-EOS area used when the requested -o path resolves to EOS."""
    user = os.environ.get('USER') or os.environ.get('LOGNAME')
    if user:
        return '/afs/cern.ch/user/{}/{}/condor_jobs_files'.format(user[0], user)
    return None


def _resolve_condor_output_dir(requested_output, condor_workdir, log_prx):
    """
    Return (submit_output_dir, requested_abs_dir, remapped).

    Standard CERN batch schedds reject /eos, /store and root:// paths in the
    submit file.  If the user runs from an EOS-based CMSSW area, a relative
    -o also becomes /eos/..., so mirror only the Condor bookkeeping area under
    AFS while leaving --final-output unchanged.
    """
    requested_abs = os.path.abspath(requested_output)

    if not _is_forbidden_condor_submit_path(requested_abs):
        return requested_abs, requested_abs, False

    base = (condor_workdir
            or os.environ.get('RECO2PICO_CONDOR_WORKDIR')
            or os.environ.get('RECO2PICO_CONDOR_BASE')
            or _default_condor_workdir())

    if not base:
        KILL(log_prx+'could not choose a non-EOS Condor job area automatically. '
             +'Pass --condor-workdir /afs/cern.ch/user/<x>/<user>/condor_jobs_files')

    base = os.path.abspath(os.path.expanduser(os.path.expandvars(base)))

    if _is_forbidden_condor_submit_path(base):
        KILL(log_prx+'invalid --condor-workdir: '+base+'\n'
             +'  The Condor bookkeeping area must not be under /eos, /store, or root://.')

    if os.path.isabs(requested_output):
        suffix = _sanitize_path_fragment(requested_abs)
    else:
        suffix = requested_output.strip('/') or 'jobs'

    return os.path.abspath(os.path.join(base, suffix)), requested_abs, True


def htc_exe_prologue():
    return r"""set -euo pipefail

# ----------------------------------------------------------------------
# Run the whole job inside the CMS EL8 container when executed on EL9.
# This avoids:
#  - SCRAM el8-on-el9 runtime warnings/errors
#  - xrootd clients picking host libraries, e.g. libreadline.so.7 issues
# ----------------------------------------------------------------------
if [[ -f /etc/redhat-release ]] && grep -qE 'AlmaLinux.*release 9|Red Hat.*release 9|CentOS Stream.*9' /etc/redhat-release; then
  if [[ -z "${JME_CONDOR_INSIDE_EL8:-}" ]] && command -v cmssw-el8 >/dev/null 2>&1; then
    echo "[INFO] Host is EL9; re-exec inside cmssw-el8 container..."
    export JME_CONDOR_INSIDE_EL8=1
    exec cmssw-el8 -- "$0" "$@"
  fi
fi

# Keep persistent job bookkeeping separate from large temporary ROOT files.
# Condor starts the job in initialdir=$BASEDIR/job_N; never use that directory
# as the cmsRun working area.
JOBDIR="$(cd "$(dirname "$0")" && pwd -P)"
INITIALDIR="$(pwd -P)"

_tmp_parent=""
for _candidate in "${TMPDIR:-}" "${_CONDOR_SCRATCH_DIR:-}" /tmp /var/tmp; do
  [[ -n "${_candidate}" ]] || continue
  [[ -d "${_candidate}" && -w "${_candidate}" ]] || continue
  # Avoid persistent job_N and its parent output directory.
  _candidate_real="$(cd "${_candidate}" && pwd -P)"
  [[ "${_candidate_real}" != "${JOBDIR}" ]] || continue
  [[ "${_candidate_real}" != "$(cd "${JOBDIR}/.." && pwd -P)" ]] || continue
  _tmp_parent="${_candidate_real}"
  break
done

if [[ -z "${_tmp_parent}" ]]; then
  echo "[ERROR] Could not find a writable temporary area outside ${JOBDIR}"
  exit 87
fi

WORKDIR="$(mktemp -d -p "${_tmp_parent}" "jme_${USER:-user}_XXXXXX")"
cleanup_workdir() {
  local status=$?
  if [[ -d "${WORKDIR}" ]]; then
    echo "[INFO] Removing temporary workdir ${WORKDIR}"
    rm -rf "${WORKDIR}"
  fi
  exit ${status}
}
trap cleanup_workdir EXIT

cd "${WORKDIR}"
echo "JOBDIR=${JOBDIR}"
echo "INITIALDIR=${INITIALDIR}"
echo "WORKDIR=${WORKDIR}"
echo "OS: $(cat /etc/redhat-release 2>/dev/null || true)"
echo "uname: $(uname -a 2>/dev/null || true)"
echo "HOSTNAME=${HOSTNAME:-<unset>}"
echo "USER=${USER:-<unset>}"

# Fallback for local tests or sites that do not set X509_USER_PROXY after
# x509userproxy transfer. exe.sh lives in BASEDIR/job_x, proxy in BASEDIR.
if [[ -z "${X509_USER_PROXY:-}" ]]; then
  _jme_proxy="${JOBDIR}/../X509_USER_PROXY"
  if [[ -r "${_jme_proxy}" ]]; then
    export X509_USER_PROXY="${_jme_proxy}"
  fi
  unset _jme_proxy
fi

echo "X509_USER_PROXY=${X509_USER_PROXY:-<unset>}"
if [[ -z "${X509_USER_PROXY:-}" || ! -r "${X509_USER_PROXY}" ]]; then
  echo "[ERROR] X509 proxy is missing or not readable inside the job."
  exit 88
fi

if command -v voms-proxy-info >/dev/null 2>&1; then
  echo "=== voms-proxy-info (summary) ==="
  voms-proxy-info -timeleft || true
  voms-proxy-info -identity || true
fi

# Make scram available on batch workers.
if [[ -f /cvmfs/cms.cern.ch/cmsset_default.sh ]]; then
  source /cvmfs/cms.cern.ch/cmsset_default.sh
fi

jme_use_cmssw_xrootd() {
  local xrootd_base=""
  xrootd_base="$(scram tool info xrootd 2>/dev/null | awk -F= '/^XROOTD_BASE=/{print $2}' | tail -n 1 || true)"

  if [[ -n "${xrootd_base}" && -d "${xrootd_base}/bin" ]]; then
    export PATH="${xrootd_base}/bin:${PATH}"
    [[ -d "${xrootd_base}/lib64" ]] && export LD_LIBRARY_PATH="${xrootd_base}/lib64:${LD_LIBRARY_PATH:-}"
    [[ -d "${xrootd_base}/lib"   ]] && export LD_LIBRARY_PATH="${xrootd_base}/lib:${LD_LIBRARY_PATH:-}"
  fi

  echo "which xrdfs: $(command -v xrdfs || echo '<not found>')"
  echo "which xrdcp: $(command -v xrdcp || echo '<not found>')"
}

jme_stageout() {
  local src="${1:?missing local source file}"
  local dst="${2:?missing destination path}"
  local dst_dir
  dst_dir="$(dirname "${dst}")"

  echo "[INFO] stageout: ${src} -> ${dst}"

  if [[ ! -f "${src}" ]]; then
    echo "[ERROR] local output does not exist: ${src}"
    echo "[ERROR] pwd=$(pwd)"
    echo "[ERROR] available files:"
    ls -lh
    exit 89
  fi

  if [[ "${dst}" == /eos/* ]]; then
    local eos_host="eosuser.cern.ch"
    [[ "${dst}" == /eos/cms/* ]] && eos_host="eoscms.cern.ch"

    xrdfs "${eos_host}" mkdir -p "${dst_dir}" || true
    xrdcp -f "${src}" "root://${eos_host}//${dst}"

  elif [[ "${dst}" == /store/* ]]; then
    xrdfs eoscms.cern.ch mkdir -p "${dst_dir}" || true
    xrdcp -f "${src}" "root://eoscms.cern.ch//${dst}"

  elif [[ "${dst}" == root://* ]]; then
    xrdcp -f "${src}" "${dst}"

  else
    mkdir -p "${dst_dir}"
    cp -f "${src}" "${dst}"
  fi

  rm -f "${src}"
}
"""


if __name__ == '__main__':
   parser = argparse.ArgumentParser(
    prog='./'+os.path.basename(__file__),
    formatter_class=argparse.RawDescriptionHelpFormatter,
    description=__doc__)

   parser.add_argument('-c', '--cfg', dest='cmsRun_cfg', action='store', default=None, required=True,
                       help='path to cmsRun cfg file')
   parser.add_argument('--steps', help='JSON list of subsequent cmsRun steps')
   parser.add_argument('--save-intermediates', action='store_true',
                       help='also transfer intermediate outputs after their consumer succeeds')
   parser.add_argument('--disk-mb', type=int,
                       help='Condor scratch-disk request in MiB for the entire chain')
   parser.add_argument('-d', '--dataset', dest='dataset', action='store', default=None, required=True,
                       help='name of input data set in DAS or path to dataset json dump')
   parser.add_argument('-o', '--output', dest='output', action='store', default=None, required=True,
                       help='path to Condor job directory; if this resolves under /eos it is mirrored under --condor-workdir')
   parser.add_argument('--condor-workdir', dest='condor_workdir', action='store', default=None, required=False,
                       help='non-EOS base directory for Condor bookkeeping when -o resolves under /eos; default: /afs/cern.ch/user/${USER:0:1}/${USER}/condor_jobs_files')
   parser.add_argument('-fo', '--final-output', dest='final_output', action='store', default='./', required=False,
                       help='path to final output directory i.e. directory with the PicoAOD ROOT files')
   parser.add_argument('--lumi-json', '--golden-json', '--lumi-mask', dest='lumi_json',
                       action='store', default=None, required=False,
                       help='CMS Golden JSON / lumi mask. When DAS is used, files with no run-lumi overlap are skipped before jobs are created; the same mask is also applied inside cmsRun.')
   parser.add_argument('--customize-cfg', dest='customize_cfg', action='store_true', default=False,
                       help='append minimal customization to cmsRun-cfg required by the driver')
   parser.add_argument('-j', '--jobdirname', dest='jobdirname', action='store', default='job',
                       help='prefix of batch-job sub-directories')
   parser.add_argument('-f', '--max-files', dest='max_files', action='store', type=int, default=-1,
                       help='maximum number of input files to be processed')
   parser.add_argument('-m', '--max-events', dest='max_events', action='store', type=int, default=-1,
                       help='maximum number of total input events to be processed')
   parser.add_argument('-n', '--n-events', dest='n_events', action='store', type=int, default=-1,
                       help='maximum number of events per job')
   parser.add_argument('-p', '--parentFiles-level', dest='parentFiles_level', action='store', type=int, default=2,
                       help='level of parentFiles to be used as secondary input files')
   parser.add_argument('-b', '--batch-system', dest='batch_system', action='store', default='auto', choices=['auto', 'htc', 'slurm'],
                       help='keyword to select batch system')
   parser.add_argument('--cpus', dest='cpus', action='store', default='1',
                       help='number of CPUs per job')
   parser.add_argument('--memory', dest='memory', action='store', default='50M',
                       help='job max memory')
   parser.add_argument('-t', '--time', dest='time', action='store', default='01:00:00',
                       help='job runtime in seconds or HH:MM:SS')
   parser.add_argument('-q', '--queue', dest='queue', action='store', default='standard',
                       help='name of partition on the batch system')
   parser.add_argument('--JobFlavour', dest='JobFlavour', action='store', default=None,
                       help='argument of HTCondor parameter "+JobFlavour"')
   parser.add_argument('--AccountingGroup', dest='AccountingGroup', action='store', default=None,
                       help='argument of HTCondor parameter "+AccountingGroup"')
   parser.add_argument('--name', dest='job_name', action='store', default=None,
                       help='name of batch job')
   parser.add_argument('--customise-commands', '--customize-commands', dest='customise_commands', nargs='+', default=[],
                       help='list of strings appended to final cmsRun configuration file')
   parser.add_argument('--submit', dest='submit', action='store_true', default=False,
                       help='submit job(s) on the batch system')
   parser.add_argument('--export-LD-LIBRARY-PATH', dest='export_LD_LIBRARY_PATH', action='store_true', default=False,
                       help='export LD_LIBRARY_PATH in batch-job executable')
   parser.add_argument('--dry-run', dest='dry_run', action='store_true', default=False,
                       help='enable dry-run mode')
   parser.add_argument('-v', '--verbosity', dest='verbosity', nargs='?', type=int, default=0, const=1,
                       help='level of verbosity')

   opts, opts_unknown = parser.parse_known_args()
   log_prx = os.path.basename(__file__)+' -- '

   # Optional Golden JSON / lumi mask.  If provided, this is used twice:
   #   1) during DAS discovery, to avoid creating jobs for files with no
   #      overlap with the mask;
   #   2) inside cmsRun, to drop bad lumisections within selected files.
   if opts.lumi_json is not None:
     opts.lumi_json = os.path.abspath(os.path.expanduser(os.path.expandvars(opts.lumi_json)))
     if not os.path.isfile(opts.lumi_json):
       KILL(log_prx+'invalid path to Golden JSON / lumi mask [--lumi-json]: '+str(opts.lumi_json))
     try:
       with open(opts.lumi_json) as _lumi_json_handle:
         json.load(_lumi_json_handle)
     except Exception as _lumi_json_err:
       KILL(log_prx+'failed to parse Golden JSON / lumi mask [--lumi-json]: '+str(opts.lumi_json)+'\n'+str(_lumi_json_err))

   OUTPUT_DIR, REQUESTED_OUTPUT_DIR, OUTPUT_DIR_WAS_REMAPPED = _resolve_condor_output_dir(
     opts.output, opts.condor_workdir, log_prx)

   if 'CMSSW_BASE' not in os.environ:
     KILL(log_prx+'global variable CMSSW_BASE is not defined (set up CMSSW environment with "cmsenv" before submitting jobs)')

   if not os.path.isfile(opts.cmsRun_cfg):
     KILL(log_prx+'invalid path to cmsRun cfg file [-c]: '+str(opts.cmsRun_cfg))

   if opts.save_intermediates and not opts.steps:
     parser.error('--save-intermediates requires --steps')
   if opts.disk_mb is not None and opts.disk_mb <= 0:
     parser.error('--disk-mb must be positive')
   try:
     steps = load_steps(opts.steps, os.environ['CMSSW_BASE'], os.environ.get('SCRAM_ARCH'))
   except (OSError, ValueError) as error:
     parser.error(str(error))
   if steps:
     reserved = {'inputFiles', 'secondaryInputFiles', 'output', 'outputFile',
                 'maxEvents', 'skipEvents'}
     for argument in opts_unknown:
       key = argument.split('=', 1)[0]
       if key in reserved or key.endswith('_load'):
         parser.error('step chaining owns argument '+key)

   if OUTPUT_DIR_WAS_REMAPPED:
     print(colored_text('warning:', ['1', '93']),
           'requested -o resolves to an EOS path that standard CERN schedds reject: '+REQUESTED_OUTPUT_DIR)
     print(colored_text('warning:', ['1', '93']),
           'using non-EOS Condor bookkeeping area instead: '+OUTPUT_DIR)

   if opts.batch_system == 'slurm':
     KILL(log_prx+'this bdriver is intended for the HTCondor workflow used by the JME-style scripts; use --batch-system htc')

   if opts.batch_system == 'auto':
     opts.batch_system = 'htc'

   if opts.batch_system == 'htc':
     try:
       which('condor_q')
     except:
       KILL(log_prx+'selected HTCondor batch system, but the executable "condor_q" is not available')

   if opts.submit and (not opts.dry_run):
     which('condor_submit')

   if os.path.exists(OUTPUT_DIR):
     msg = log_prx+'target path to Condor output directory already exists: '+str(OUTPUT_DIR)
     if OUTPUT_DIR_WAS_REMAPPED:
       msg += '\n  This is the non-EOS mirror of requested -o path: '+REQUESTED_OUTPUT_DIR
       msg += '\n  Remove it, choose a new ODIR, or pass a different --condor-workdir.'
     KILL(msg)

   if opts.n_events == 0:
     KILL(log_prx+'logic error: requesting zero events per job')
   if opts.max_events == 0:
     KILL(log_prx+'logic error: requesting a maximum of zero input events')
   if opts.max_files == 0:
     KILL(log_prx+'logic error: requesting a maximum of zero input files')

   try:
     time_mins, time_secs = divmod(int(opts.time), 60)
     time_hours, time_mins = divmod(time_mins, 60)
     TIME_STR_secs = opts.time
   except:
     try:
       TIME_STR_blocks = opts.time.split(':')
       assert len(TIME_STR_blocks) == 3
       TIME_STR_secs = str(int(TIME_STR_blocks[0])*3600 + int(TIME_STR_blocks[1])*60 + int(TIME_STR_blocks[2]))
     except:
       KILL(log_prx+'invalid format for maximum runtime [--time/-t]: '+opts.time)

   try:
     memory_htc = int(opts.memory)
     memory_htc_str = str(memory_htc)
   except:
     try:
       memory_dictionary = {'M':1, 'G':1000}
       memory_htc = int(opts.memory[0:(len(opts.memory)-1)]) * memory_dictionary[opts.memory[len(opts.memory)-1]]
       memory_htc_str = str(memory_htc)
     except:
       KILL(log_prx+'invalid format for requested memory [--memory]: '+opts.memory)

   cmsRun_addopts = opts_unknown[:]

   if opts.verbosity > 0 and len(cmsRun_addopts):
     print('-'*50)
     print(colored_text('additional cmsRun command-line arguments:', ['1']))
     for _tmp in cmsRun_addopts:
       print(' '+str(_tmp))
     print('-'*50)

   if os.path.isfile(opts.dataset):
     input_dset = skim_das_jsondump(
       file_path=opts.dataset,
       max_files=opts.max_files,
       max_events=opts.max_events,
       lumi_json=opts.lumi_json,
       verbose=(opts.verbosity > 0),
     )
   else:
     which('dasgoclient')
     input_dset = load_dataset_data(
       das_name=opts.dataset,
       max_files=opts.max_files,
       max_events=opts.max_events,
       parentFiles_levels=opts.parentFiles_level,
       lumi_json=opts.lumi_json,
       verbose=(opts.verbosity > 0),
     )

   if isinstance(input_dset, dict) and input_dset.get('lumiMaskReport') is not None:
     _lumi_report = input_dset['lumiMaskReport']
     print(colored_text('lumi-mask selected runs:', ['1', '92']), len(_lumi_report.get('selected_runs', [])))
     print(colored_text('lumi-mask selected files:', ['1', '92']), _lumi_report.get('selected_files', 0))
     print(colored_text('lumi-mask selected file-level events:', ['1', '92']), _lumi_report.get('selected_events', 0))
     if _lumi_report.get('stopped_early'):
       print(colored_text('lumi-mask stopped early:', ['1', '93']), _lumi_report.get('stop_reason'))

   nJobs, totEvents, breakLoop = 0, 0, False
   for i_inpfdc in input_dset['files']:
     i_nevents = i_inpfdc['nevents']
     totEvents += i_nevents
     if (opts.max_events > 0) and (totEvents >= opts.max_events):
       i_nevents -= (totEvents - opts.max_events)
       breakLoop = True
     nJobs += int(math.ceil(float(i_nevents) / opts.n_events)) if (opts.n_events > 0) else 1
     if breakLoop:
       break

   if nJobs == 0:
     KILL(log_prx+'input error: expected number of batch jobs is zero: '+opts.dataset)

   jobIndex_nDigits = max(1, len(str(nJobs - 1)))
   outputname_postfix_format = '_{:0'+str(jobIndex_nDigits)+'d}'
   del nJobs, totEvents, breakLoop

   voms_proxy_path = os.environ['X509_USER_PROXY'] if 'X509_USER_PROXY' in os.environ else '/tmp/x509up_u'+str(os.getuid())

   if not os.path.isfile(voms_proxy_path):
     EXE('voms-proxy-init --voms cms', verbose=(opts.verbosity > 0), dry_run=opts.dry_run)

   if not os.path.isfile(voms_proxy_path):
     KILL(log_prx+'invalid path to voms proxy: '+voms_proxy_path)

   # OUTPUT_DIR is the local/AFS Condor job area and is the only path used by condor.sub.
   OUTPUT_DIR_FINAL = OUTPUT_DIR

   # Keep local final outputs outside the temporary WORKDIR when -fo is not EOS/root://.
   # EOS and root:// destinations are preserved verbatim for xrdcp stage-out.
   if opts.final_output.startswith('/eos/') or opts.final_output.startswith('/store/') or opts.final_output.startswith('root://'):
     FINAL_OUTPUT_DIR = opts.final_output.rstrip('/')
   else:
     FINAL_OUTPUT_DIR = os.path.abspath(opts.final_output).rstrip('/')

   print(colored_text('final output:', ['1', '92']), FINAL_OUTPUT_DIR)
   print(colored_text('condor job area:', ['1', '92']), OUTPUT_DIR)

   MKDIRP(OUTPUT_DIR, verbose=(opts.verbosity > 0), dry_run=opts.dry_run)
   MKDIRP(OUTPUT_DIR+'/logs', verbose=(opts.verbosity > 0), dry_run=opts.dry_run)

   EXE('cp '+_quote(voms_proxy_path)+' '+_quote(OUTPUT_DIR+'/X509_USER_PROXY'), verbose=(opts.verbosity > 0), dry_run=opts.dry_run)

   out_cmsRun_cfg = os.path.abspath(OUTPUT_DIR+'/cfg.py')
   EXE('cp '+_quote(opts.cmsRun_cfg)+' '+_quote(out_cmsRun_cfg), verbose=(opts.verbosity > 0), dry_run=opts.dry_run)

   for number, step in enumerate(steps, 2):
     copied_cfg = os.path.abspath(OUTPUT_DIR+'/step{}_cfg.py'.format(number))
     EXE('cp '+_quote(step['cfg'])+' '+_quote(copied_cfg),
         verbose=(opts.verbosity > 0), dry_run=opts.dry_run)
     step['cfg'] = copied_cfg
   if steps and not opts.dry_run:
     with open(OUTPUT_DIR+'/steps.json', 'w') as handle:
       json.dump(steps, handle, indent=2)

   out_lumi_json = None
   if opts.lumi_json is not None:
     out_lumi_json = os.path.abspath(OUTPUT_DIR+'/lumiMask.json')
     EXE('cp '+_quote(opts.lumi_json)+' '+_quote(out_lumi_json), verbose=(opts.verbosity > 0), dry_run=opts.dry_run)

   if opts.customize_cfg and not opts.dry_run:
     with open(out_cmsRun_cfg, 'a') as cfg_file:
       custom_str = """
###
### customization added by {:} [time-stamp: {:}]
###
import FWCore.ParameterSet.Config as cms
import FWCore.ParameterSet.VarParsing as vpo

# Do not create and parse a second independent VarParsing object if the
# original cfg already defined opts and called opts.parseArguments().
# That was the main source of confusing maxEvents/output behaviour.
try:
    opts
except NameError:
    opts = vpo.VarParsing('analysis')
    try:
        opts.register('skipEvents', 0,
                      vpo.VarParsing.multiplicity.singleton,
                      vpo.VarParsing.varType.int,
                      'number of events to be skipped')
    except RuntimeError as err:
        if 're-register' not in str(err):
            raise
    try:
        opts.register('output', 'out.root',
                      vpo.VarParsing.multiplicity.singleton,
                      vpo.VarParsing.varType.string,
                      'path to output file')
    except RuntimeError as err:
        if 're-register' not in str(err):
            raise
    opts.parseArguments()

# max number of events to be processed
if hasattr(process, 'maxEvents'):
    process.maxEvents.input = opts.maxEvents

# number of events to be skipped
if hasattr(process, 'source') and hasattr(opts, 'skipEvents'):
    process.source.skipEvents = cms.untracked.uint32(opts.skipEvents)

# input EDM files [primary]
if hasattr(process, 'source'):
    process.source.fileNames = opts.inputFiles

# input EDM files [secondary]
if hasattr(process, 'source') and hasattr(opts, 'secondaryInputFiles'):
    process.source.secondaryFileNames = opts.secondaryInputFiles

# output file: current Reco2Pico cfg uses opts.output, while older CMSSW
# templates sometimes use opts.outputFile. Support both.
_driver_output = getattr(opts, 'output', None)
if _driver_output is None:
    _driver_output = getattr(opts, 'outputFile', None)
if _driver_output is not None:
    # cmsDriver may name its output RECOSIMoutput rather than out.
    # Preserve the legacy handling below for existing configurations.
    if not any(hasattr(process, name) for name in ('out', 'nanoAODOutput')):
        _driver_modules = list(process.outputModules_().values())
        if len(_driver_modules) == 1:
            _driver_modules[0].fileName = cms.untracked.string(_driver_output)
        elif len(_driver_modules) > 1:
            raise RuntimeError('Ambiguous output modules: configure one output per driver step')
        elif not hasattr(process, 'TFileService'):
            raise RuntimeError('No supported output module or TFileService found')
    for _modname in ('out', 'nanoAODOutput'):
        if hasattr(process, _modname) and hasattr(getattr(process, _modname), 'fileName'):
            getattr(process, _modname).fileName = cms.untracked.string(_driver_output)
    if hasattr(process, 'TFileService'):
        process.TFileService.fileName = cms.string(_driver_output)
del _driver_output
"""
       if opts.customise_commands:
         custom_str += '\n'+'\n'.join(opts.customise_commands)+'\n'
       cfg_file.write(custom_str.format(os.path.basename(__file__), str(datetime.datetime.now())))

   if (out_lumi_json is not None) and (not opts.dry_run):
     with open(out_cmsRun_cfg, 'a') as cfg_file:
       cfg_file.write('''

###
### lumi mask added by {:} [time-stamp: {:}]
###
import FWCore.PythonUtilities.LumiList as LumiList
process.source.lumisToProcess = LumiList.LumiList(filename={:}).getVLuminosityBlockRange()
'''.format(os.path.basename(__file__), str(datetime.datetime.now()), repr(out_lumi_json)))

   if not opts.dry_run:
     with open(os.path.abspath(OUTPUT_DIR+'/cmdLog'), 'w') as file_cmdLog:
       file_cmdLog.write((' '.join(sys.argv[:]))+'\n')
     with open(os.path.abspath(OUTPUT_DIR+'/paths.json'), 'w') as file_paths:
       json.dump({
         'requested_output_dir': REQUESTED_OUTPUT_DIR,
         'condor_output_dir': OUTPUT_DIR,
         'output_dir_was_remapped': OUTPUT_DIR_WAS_REMAPPED,
         'final_output_dir': FINAL_OUTPUT_DIR,
         'lumi_json': out_lumi_json,
       }, file_paths, sort_keys=True, indent=2)
     json.dump(input_dset, open(OUTPUT_DIR+'/dataset.json', 'w'), sort_keys=True, indent=2)

     lumi_report = input_dset.get('lumiMaskReport') if isinstance(input_dset, dict) else None
     if lumi_report is not None:
       with open(os.path.abspath(OUTPUT_DIR+'/lumiMaskReport.json'), 'w') as file_lumi_report:
         json.dump(lumi_report, file_lumi_report, sort_keys=True, indent=2)
       with open(os.path.abspath(OUTPUT_DIR+'/lumiMaskReport.txt'), 'w') as file_lumi_report_txt:
         file_lumi_report_txt.write('Reco2Pico DAS lumi-mask preselection report\n')
         file_lumi_report_txt.write('===========================================\n')
         file_lumi_report_txt.write('Dataset: {:}\n'.format(input_dset.get('DAS', '<unknown>')))
         file_lumi_report_txt.write('Lumi JSON: {:}\n'.format(lumi_report.get('lumi_json', '<unknown>')))
         file_lumi_report_txt.write('Selection mode: {:}\n'.format(lumi_report.get('selection_mode', '<unknown>')))
         file_lumi_report_txt.write('Dataset runs: {:}\n'.format(len(lumi_report.get('dataset_runs', []))))
         file_lumi_report_txt.write('Lumi-mask runs: {:}\n'.format(len(lumi_report.get('lumi_mask_runs', []))))
         file_lumi_report_txt.write('Selected runs: {:}\n'.format(len(lumi_report.get('selected_runs', []))))
         file_lumi_report_txt.write('Rejected dataset runs: {:}\n'.format(len(lumi_report.get('rejected_runs', []))))
         file_lumi_report_txt.write('Selected files: {:}\n'.format(lumi_report.get('selected_files', 0)))
         file_lumi_report_txt.write('Selected file-level events: {:}\n'.format(lumi_report.get('selected_events', 0)))
         file_lumi_report_txt.write('Stopped early: {:}\n'.format(lumi_report.get('stopped_early', False)))
         file_lumi_report_txt.write('Stop reason: {:}\n'.format(lumi_report.get('stop_reason', None)))
         file_lumi_report_txt.write('\nSelected runs and files\n')
         file_lumi_report_txt.write('-----------------------\n')
         for run in sorted(lumi_report.get('runs', {}).keys(), key=lambda x: int(x)):
           run_info = lumi_report['runs'][run]
           file_lumi_report_txt.write('Run {:}: {:} selected files, {:} file-level events ({:} DAS candidate files)\n'.format(
             run,
             run_info.get('selected_files', 0),
             run_info.get('selected_events', 0),
             run_info.get('candidate_files_from_das', 0),
           ))
           for file_name in run_info.get('files', []):
             file_lumi_report_txt.write('  {:}\n'.format(file_name))

   retcode = EXE('edmConfigDump '+_quote(out_cmsRun_cfg)+' 2> '+_quote(OUTPUT_DIR+'/configDump.log')+' > '+_quote(OUTPUT_DIR+'/configDump.py'), suspend=False, verbose=(opts.verbosity > 0), dry_run=opts.dry_run)
   if retcode:
     EXE('cat '+_quote(OUTPUT_DIR+'/configDump.log'), verbose=(opts.verbosity > 0), dry_run=opts.dry_run)
     raise SystemExit(retcode)

   SUBFILE_ABSPATH = OUTPUT_DIR+'/condor.sub'
   if os.path.exists(SUBFILE_ABSPATH):
     KILL(log_prx+'target output file already exists (condor submission file): '+SUBFILE_ABSPATH)

   # IMPORTANT: BASEDIR must be the local/AFS Condor job area, never --final-output.
   # EOS paths are used only inside exe.sh, where jme_stageout performs xrdcp.
   SUBFILE_LINES = [
     'BASEDIR = '+OUTPUT_DIR_FINAL,
     'batch_name = '+(opts.job_name if opts.job_name is not None else '$Fn(BASEDIR)'),
     'initialdir = $DIRNAME(QFILE)',
     'executable = $(initialdir)/exe.sh',
     'output = $DIRNAME(QFILE)/logs/out.$(Cluster).$(Process)',
     'error  = $DIRNAME(QFILE)/logs/err.$(Cluster).$(Process)',
     'log    = $(BASEDIR)/condor.$(Cluster).log',
     '#arguments =',
     '#transfer_executable = True',
     '#transfer_input_files =',
     'universe = vanilla',
     'getenv = True',
     'use_x509userproxy = True',
     'should_transfer_files = IF_NEEDED',
     'when_to_transfer_output = ON_EXIT',
     'MY.WantOS = "el8"',
     'RequestCpus = '+opts.cpus,
     'RequestMemory = '+memory_htc_str,
     '+MaxRuntime = '+TIME_STR_secs,
   ]

   if opts.JobFlavour is not None:
     JobFlavour = opts.JobFlavour.strip('\'"')
     SUBFILE_LINES += ['+JobFlavour = "{:}"'.format(JobFlavour)]

   if opts.disk_mb is not None:
     SUBFILE_LINES += ['RequestDisk = '+str(opts.disk_mb * 1024)]

   if opts.AccountingGroup is not None:
     AccountingGroup = opts.AccountingGroup.strip('\'"')
     SUBFILE_LINES += ['+AccountingGroup = "{:}"'.format(AccountingGroup)]

   SUBFILE_LINES += [
     'x509userproxy = $(BASEDIR)/X509_USER_PROXY',
     'queue QFILE matching files $(BASEDIR)/*/flag.queue',
   ]

   if not opts.dry_run:
     with open(SUBFILE_ABSPATH, 'w') as f_subfile:
       for _tmp in SUBFILE_LINES:
         f_subfile.write(_tmp+'\n')

   jobCounter = 0
   totEvents = 0
   breakLoop = False

   for i_inpfdc in input_dset['files']:
     i_inputFile = i_inpfdc['file']
     i_inputFile_nevents = i_inpfdc['nevents']

     i_secondaryInputFiles = None
     if opts.parentFiles_level == 2:
       i_secondaryInputFiles = i_inpfdc['parentFiles_2']
     elif opts.parentFiles_level == 1:
       i_secondaryInputFiles = i_inpfdc['parentFiles_1']

     if isinstance(i_secondaryInputFiles, list) and len(i_secondaryInputFiles) == 0:
       KILL(log_prx+'list of secondary input files is empty (parentFiles_level = '+str(opts.parentFiles_level)+')')

     i_njobs = int(math.ceil(float(i_inputFile_nevents) / opts.n_events)) if (opts.n_events > 0) else 1
     i_nevt_remainder = i_inputFile_nevents % opts.n_events if (opts.n_events > 0) else 0

     for i_job in range(i_njobs):
       i_OUTPUT_DIR = OUTPUT_DIR+'/'+opts.jobdirname+outputname_postfix_format.format(jobCounter)

       MKDIRP(i_OUTPUT_DIR+'/logs', verbose=(opts.verbosity > 0), dry_run=opts.dry_run)

       i_maxEvents = opts.n_events if (opts.n_events > 0) else i_inputFile_nevents
       if (i_job == (i_njobs - 1)) and (i_nevt_remainder != 0):
         i_maxEvents = i_nevt_remainder

       totEvents += i_maxEvents
       if (opts.max_events > 0) and (totEvents >= opts.max_events):
         i_maxEvents -= (totEvents - opts.max_events)
         breakLoop = True

       EXE('touch '+_quote(i_OUTPUT_DIR+'/flag.queue'), verbose=(opts.verbosity > 0), dry_run=opts.dry_run)

       EXEFILE_ABSPATH = i_OUTPUT_DIR+'/exe.sh'
       if os.path.exists(EXEFILE_ABSPATH):
         KILL(log_prx+'target output file already exists (executable of batch job): '+EXEFILE_ABSPATH)

       if not opts.dry_run:
         with open(EXEFILE_ABSPATH, 'w') as f_exefile:
           f_exefile.write('#!/bin/bash\n')
           f_exefile.write(htc_exe_prologue())

           if opts.export_LD_LIBRARY_PATH and 'LD_LIBRARY_PATH' in os.environ:
             f_exefile.write('\nexport LD_LIBRARY_PATH='+os.environ['LD_LIBRARY_PATH']+'\n')

           output_basename = 'out'+outputname_postfix_format.format(jobCounter)+'.root'
           final_output_path = _join_output_path(FINAL_OUTPUT_DIR, output_basename)
           skip_events = opts.n_events*i_job if opts.n_events > 0 else 0

           cmsRun_opts = out_cmsRun_cfg
           cmsRun_opts += ' \\\n maxEvents='+str(i_maxEvents)
           cmsRun_opts += ' \\\n skipEvents='+str(skip_events)
           cmsRun_opts += ' \\\n inputFiles='+str(i_inputFile)
           if i_secondaryInputFiles:
             cmsRun_opts += ' \\\n secondaryInputFiles='+str(','.join(i_secondaryInputFiles))
           cmsRun_opts += ' \\\n output='+output_basename

           for _tmp in cmsRun_addopts:
             cmsRun_opts += ' \\\n '+str(_tmp)

           if steps:
             # Rebuild as quoted arguments; reserve out_N.root for the final step.
             first_args = ['cmsRun', '-j', i_OUTPUT_DIR+'/logs/step1.xml', out_cmsRun_cfg]
             first_args += cmsRun_addopts
             first_args += ['maxEvents='+str(i_maxEvents), 'skipEvents='+str(skip_events),
                            'inputFiles='+str(i_inputFile), 'output=step1_'+output_basename]
             if i_secondaryInputFiles:
               first_args += ['secondaryInputFiles='+','.join(i_secondaryInputFiles)]
             first_command = ' '.join(_quote(arg) for arg in first_args)

           i_SHELL_COMMANDS = [
             ['cd '+_quote(os.environ['CMSSW_BASE']+'/src')],
             ['eval `scram runtime -sh`'],
             ['jme_use_cmssw_xrootd || true'],
             ['cd "${WORKDIR}"'],
             ['[ ! -f '+_quote(i_OUTPUT_DIR+'/flag.done')+' ] || exit 0'],
             ['echo "[INFO] cmsRun command follows"'],
             ['echo '+_quote('cmsRun '+cmsRun_opts)],
             ['cmsRun '+cmsRun_opts],
             ['echo "[INFO] WORKDIR content after cmsRun"'],
             ['ls -lh'],
             ['jme_stageout '+_quote(output_basename)+' '+_quote(final_output_path)],
             ['touch '+_quote(i_OUTPUT_DIR+'/flag.done')],
           ]

           if steps:
             # Keep the existing environment setup and completed-job check.
             i_SHELL_COMMANDS = i_SHELL_COMMANDS[:5]
             i_SHELL_COMMANDS += [
               ['echo '+_quote('[INFO] starting step 1')],
               [first_command],
             ]
             i_SHELL_COMMANDS += chained_commands(
               steps, output_basename, FINAL_OUTPUT_DIR, i_OUTPUT_DIR,
               opts.save_intermediates, os.environ['SCRAM_ARCH'])
             i_SHELL_COMMANDS += [['touch '+_quote(i_OUTPUT_DIR+'/flag.done')]]

           f_exefile.write('\n'+('\n\n'.join([' \\\n '.join(_tmp) for _tmp in i_SHELL_COMMANDS]))+'\n')

         os.chmod(EXEFILE_ABSPATH, os.stat(EXEFILE_ABSPATH).st_mode | stat.S_IEXEC)

       print(colored_text('output:', ['1', '94']), os.path.relpath(EXEFILE_ABSPATH, os.environ['PWD']))

       jobCounter += 1

       if breakLoop:
         break

     if breakLoop:
       break

   print(colored_text('prepared jobs:', ['1', '92']), jobCounter)
   print(colored_text('submit file:', ['1', '92']), SUBFILE_ABSPATH)

   if opts.submit:
     EXE('condor_submit '+_quote(SUBFILE_ABSPATH), suspend=False, verbose=(opts.verbosity > 0), dry_run=opts.dry_run)
