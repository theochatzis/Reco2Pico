#!/usr/bin/env python3
"""
Create HTCondor job areas for Reco2Pico cmsRun production.
"""


import argparse
import datetime
import json
import math
import os
import shlex
import stat
import sys

from Reco2Pico.PicoProducer.utils.common import EXE, KILL, MKDIRP, colored_text, which
from Reco2Pico.PicoProducer.utils.das import load_dataset_data, skim_das_jsondump


def _quote(path_or_arg):
    return shlex.quote(str(path_or_arg))


def _runtime_to_seconds_and_hhmmss(value):
    """Accept seconds or HH:MM:SS. Return (seconds_string, hhmmss_string)."""
    value = str(value)
    try:
        total = int(value)
        hours, rem = divmod(total, 3600)
        minutes, seconds = divmod(rem, 60)
        return str(total), f"{hours:d}:{minutes:02d}:{seconds:02d}"
    except ValueError:
        pass

    pieces = value.split(':')
    if len(pieces) != 3:
        KILL(f'invalid format for maximum runtime [--time/-t]: {value}')
    try:
        hours, minutes, seconds = [int(x) for x in pieces]
    except ValueError:
        KILL(f'invalid format for maximum runtime [--time/-t]: {value}')
    total = hours * 3600 + minutes * 60 + seconds
    return str(total), f"{hours:d}:{minutes:02d}:{seconds:02d}"


def _memory_to_condor_mb(value):
    """Convert values like 2000, 2000M, 2G to HTCondor RequestMemory in MB."""
    value = str(value).strip()
    if not value:
        KILL('empty value for requested memory [--memory]')

    try:
        return str(int(value))
    except ValueError:
        pass

    unit = value[-1].upper()
    number = value[:-1]
    try:
        number = float(number)
    except ValueError:
        KILL(f'invalid format for requested memory [--memory]: {value}')

    if unit == 'M':
        return str(int(number))
    if unit == 'G':
        return str(int(number * 1000))

    KILL(f'invalid format for requested memory [--memory]: {value}')


def _strip_quotes(value):
    value = str(value)
    while value.startswith(("'", '"')):
        value = value[1:]
    while value.endswith(("'", '"')):
        value = value[:-1]
    return value


def _write_customized_cfg(cfg_path, customise_commands, driver_name):
    """
    Append the minimal Reco2Pico bdriver customization.

    Important: do NOT register outputFile. VarParsing('analysis') already
    provides outputFile in CMSSW, and registering it again causes:
      RuntimeError: Attempt to re-register variable
    """
    custom = f'''

###
### customization added by {driver_name} [time-stamp: {datetime.datetime.now()}]
###
import FWCore.ParameterSet.Config as cms
import FWCore.ParameterSet.VarParsing as vpo
opts = vpo.VarParsing('analysis')

# VarParsing('analysis') already has maxEvents, inputFiles,
# secondaryInputFiles, and outputFile. Register only skipEvents.
try:
    opts.register('skipEvents', 0,
                  vpo.VarParsing.multiplicity.singleton,
                  vpo.VarParsing.varType.int,
                  'number of events to be skipped')
except RuntimeError as err:
    if 're-register' not in str(err):
        raise

opts.parseArguments()

# max number of events to be processed
process.maxEvents.input = opts.maxEvents

# number of events to be skipped
process.source.skipEvents = cms.untracked.uint32(opts.skipEvents)

# input EDM files [primary]
process.source.fileNames = opts.inputFiles

# input EDM files [secondary]
if hasattr(opts, 'secondaryInputFiles'):
    process.source.secondaryFileNames = opts.secondaryInputFiles
'''

    if customise_commands:
        custom += '\n' + '\n'.join(customise_commands) + '\n'

    with open(cfg_path, 'a') as cfg_file:
        cfg_file.write(custom)


def _cmsrun_options(cfg_relpath, max_events, skip_events, input_file, secondary_files, output_file, extra_args):
    opts = [
        cfg_relpath,
        f'maxEvents={max_events}',
        f'skipEvents={skip_events}',
        f'inputFiles={input_file}',
        f'outputFile={output_file}',
    ]

    if secondary_files:
        opts.insert(4, 'secondaryInputFiles=' + ','.join(secondary_files))

    opts.extend(extra_args)
    return opts


def _write_condor_submit_file(path, output_dir, output_dir_final, opts, memory_mb, max_runtime_seconds):
    lines = [
        'BASEDIR = ' + output_dir_final,
        'batch_name = ' + (opts.job_name if opts.job_name is not None else '$Fn(BASEDIR)'),
        'initialdir = $DIRNAME(QFILE)',
        'executable = $(initialdir)/exe.sh',
        'output = logs/out.$(Cluster).$(Process)',
        'error  = logs/err.$(Cluster).$(Process)',
        'log    = logs/log.$(Cluster).$(Process)',
        '#arguments =',
        '#transfer_executable = True',
        '#transfer_input_files =',
        'universe = vanilla',
        'getenv = True',
        'should_transfer_files = IF_NEEDED',
        'when_to_transfer_output = ON_EXIT',
        'MY.WantOS = "el8"',
        'RequestCpus = ' + str(opts.cpus),
        'RequestMemory = ' + str(memory_mb),
        '+MaxRuntime = ' + str(max_runtime_seconds),
    ]

    if opts.JobFlavour is not None:
        lines.append('+JobFlavour = "{}"'.format(_strip_quotes(opts.JobFlavour)))

    if opts.AccountingGroup is not None:
        lines.append('+AccountingGroup = "{}"'.format(_strip_quotes(opts.AccountingGroup)))

    lines += [
        'x509userproxy = $(BASEDIR)/X509_USER_PROXY',
        'queue QFILE matching files $(BASEDIR)/*/flag.queue',
    ]

    with open(path, 'w') as handle:
        handle.write('\n'.join(lines) + '\n')


def _write_job_executable(path, cmssw_base, job_dir, cmsrun_opts, export_ld_library_path=False):
    with open(path, 'w') as handle:
        handle.write('#!/bin/bash\n')
        handle.write('set -e\n\n')

        if export_ld_library_path and ('LD_LIBRARY_PATH' in os.environ):
            handle.write('export LD_LIBRARY_PATH={}\n\n'.format(_quote(os.environ['LD_LIBRARY_PATH'])))

        handle.write('echo "------------------------------------------------------------"\n')
        handle.write('echo "[`date`] Job started"\n')
        handle.write('echo "------------------------------------------------------------"\n')
        handle.write('echo "HOSTNAME: ${HOSTNAME}"\n')
        handle.write('echo "PWD: ${PWD}"\n')
        handle.write('echo "USER: ${USER}"\n')
        handle.write('echo "X509_USER_PROXY: ${X509_USER_PROXY}"\n\n')

        handle.write('cd {}\n'.format(_quote(os.path.join(cmssw_base, 'src'))))
        handle.write('eval `scram runtime -sh`\n')
        handle.write('cd {}\n\n'.format(_quote(job_dir)))
        handle.write('[ ! -f flag.done ] || exit 0\n\n')

        handle.write('cmsRun')
        for arg in cmsrun_opts:
            handle.write(' \\\n  ' + _quote(arg))
        handle.write('\n\n')

        handle.write('touch flag.done\n\n')
        handle.write('echo "------------------------------------------------------------"\n')
        handle.write('echo "[`date`] Job completed successfully"\n')
        handle.write('echo "------------------------------------------------------------"\n')

    os.chmod(path, os.stat(path).st_mode | stat.S_IEXEC)


def main():
    parser = argparse.ArgumentParser(
        prog='./' + os.path.basename(__file__),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=__doc__,
    )

    parser.add_argument('-c', '--cfg', dest='cmsRun_cfg', required=True,
                        help='path to cmsRun cfg file')
    parser.add_argument('-d', '--dataset', dest='dataset', required=True,
                        help='DAS dataset name or path to dataset json dump')
    parser.add_argument('-o', '--output', dest='output', required=True,
                        help='path to local condor job directory')
    parser.add_argument('-fo', '--final-output', dest='final_output', default='./',
                        help='directory where output PicoAOD root files are written')
    parser.add_argument('--customize-cfg', dest='customize_cfg', action='store_true', default=False,
                        help='append minimal customization to cmsRun cfg required by this driver')
    parser.add_argument('-j', '--jobdirname', dest='jobdirname', default='job',
                        help='prefix of batch-job subdirectories')
    parser.add_argument('-f', '--max-files', dest='max_files', type=int, default=-1,
                        help='maximum number of input files')
    parser.add_argument('-m', '--max-events', dest='max_events', type=int, default=-1,
                        help='maximum total number of events')
    parser.add_argument('-n', '--n-events', dest='n_events', type=int, default=-1,
                        help='maximum number of events per job')
    parser.add_argument('-p', '--parentFiles-level', dest='parentFiles_level', type=int, default=0,
                        help='parent file level for secondaryInputFiles: 0 disables, 1 or 2 enables')
    parser.add_argument('-b', '--batch-system', dest='batch_system', default='htc', choices=['htc'],
                        help='batch system; only HTCondor is supported in this Reco2Pico driver')
    parser.add_argument('--cpus', dest='cpus', default='1',
                        help='HTCondor RequestCpus')
    parser.add_argument('--memory', dest='memory', default='2000M',
                        help='HTCondor RequestMemory; accepts MB number, M, or G')
    parser.add_argument('-t', '--time', dest='time', default='01:00:00',
                        help='job runtime in seconds or HH:MM:SS')
    parser.add_argument('--JobFlavour', dest='JobFlavour', default=None,
                        help='HTCondor +JobFlavour')
    parser.add_argument('--AccountingGroup', dest='AccountingGroup', default=None,
                        help='HTCondor +AccountingGroup')
    parser.add_argument('--name', dest='job_name', default=None,
                        help='HTCondor batch_name')
    parser.add_argument('--customise-commands', '--customize-commands', dest='customise_commands',
                        nargs='+', default=[],
                        help='python lines appended to final cmsRun cfg')
    parser.add_argument('--submit', dest='submit', action='store_true', default=False,
                        help='submit jobs with condor_submit')
    parser.add_argument('--export-LD-LIBRARY-PATH', dest='export_LD_LIBRARY_PATH',
                        action='store_true', default=False,
                        help='export LD_LIBRARY_PATH explicitly inside job executable')
    parser.add_argument('--dry-run', dest='dry_run', action='store_true', default=False,
                        help='prepare nothing; only print commands where possible')
    parser.add_argument('-v', '--verbosity', dest='verbosity', nargs='?', type=int,
                        default=0, const=1,
                        help='verbosity level')

    opts, cmsrun_extra_args = parser.parse_known_args()
    log_prx = os.path.basename(__file__) + ' -- '

    if 'CMSSW_BASE' not in os.environ:
        KILL(log_prx + 'CMSSW_BASE is not defined. Run cmsenv before using bdriver.')

    cmssw_base = os.environ['CMSSW_BASE']

    if not os.path.isfile(opts.cmsRun_cfg):
        KILL(log_prx + 'invalid path to cmsRun cfg file [-c]: ' + str(opts.cmsRun_cfg))

    if os.path.exists(opts.output):
        KILL(log_prx + 'target output directory already exists [-o]: ' + str(opts.output))

    if opts.n_events == 0:
        KILL(log_prx + 'requesting zero events per job is invalid [-n]')
    if opts.max_events == 0:
        KILL(log_prx + 'requesting zero maximum input events is invalid [-m/--max-events]')
    if opts.max_files == 0:
        KILL(log_prx + 'requesting zero maximum input files is invalid [-f/--max-files]')

    max_runtime_seconds, _ = _runtime_to_seconds_and_hhmmss(opts.time)
    memory_mb = _memory_to_condor_mb(opts.memory)

    which('condor_q')
    if opts.submit and (not opts.dry_run):
        which('condor_submit')

    if opts.verbosity > 0 and cmsrun_extra_args:
        print('-' * 50)
        print(colored_text('additional cmsRun command-line arguments:', ['1']))
        for arg in cmsrun_extra_args:
            print(' ' + str(arg))
        print('-' * 50)

    if os.path.isfile(opts.dataset):
        input_dset = skim_das_jsondump(
            file_path=opts.dataset,
            max_files=opts.max_files,
            max_events=opts.max_events,
            verbose=(opts.verbosity > 0),
        )
    else:
        which('dasgoclient')
        input_dset = load_dataset_data(
            das_name=opts.dataset,
            max_files=opts.max_files,
            max_events=opts.max_events,
            parentFiles_levels=opts.parentFiles_level,
            verbose=(opts.verbosity > 0),
        )

    n_jobs = 0
    total_events = 0
    stop = False
    for fdict in input_dset['files']:
        nevents = int(fdict['nevents'])
        total_events += nevents
        if opts.max_events > 0 and total_events >= opts.max_events:
            nevents -= (total_events - opts.max_events)
            stop = True
        n_jobs += int(math.ceil(float(nevents) / opts.n_events)) if opts.n_events > 0 else 1
        if stop:
            break

    if n_jobs == 0:
        KILL(log_prx + 'expected number of jobs is zero; check dataset and event limits')

    job_digits = max(1, len(str(n_jobs - 1)))
    output_postfix = '_{:0' + str(job_digits) + 'd}'

    output_dir = os.path.abspath(opts.output)
    output_dir_final = output_dir
    final_output = os.path.abspath(opts.final_output) if not opts.final_output.startswith('/store/') else opts.final_output

    # VOMS proxy handling.
    voms_proxy_path = os.environ.get('X509_USER_PROXY', '/tmp/x509up_u' + str(os.getuid()))
    if not os.path.isfile(voms_proxy_path):
        EXE('voms-proxy-init --voms cms', verbose=(opts.verbosity > 0), dry_run=opts.dry_run)
    if not os.path.isfile(voms_proxy_path):
        KILL(log_prx + 'invalid path to VOMS proxy: ' + voms_proxy_path)

    MKDIRP(output_dir, verbose=(opts.verbosity > 0), dry_run=opts.dry_run)

    if not opts.dry_run:
        EXE('cp ' + _quote(voms_proxy_path) + ' ' + _quote(output_dir + '/X509_USER_PROXY'),
            verbose=(opts.verbosity > 0), dry_run=False)

    out_cfg = os.path.abspath(output_dir + '/cfg.py')
    EXE('cp ' + _quote(opts.cmsRun_cfg) + ' ' + _quote(out_cfg),
        verbose=(opts.verbosity > 0), dry_run=opts.dry_run)

    if opts.customize_cfg and not opts.dry_run:
        _write_customized_cfg(out_cfg, opts.customise_commands, os.path.basename(__file__))

    if not opts.dry_run:
        with open(output_dir + '/cmdLog', 'w') as handle:
            handle.write(' '.join(sys.argv) + '\n')
        with open(output_dir + '/dataset.json', 'w') as handle:
            json.dump(input_dset, handle, sort_keys=True, indent=2)

    # Validate/dump the final python config before creating the jobs.
    retcode = EXE('edmConfigDump ' + _quote(out_cfg) +
                  ' 2> ' + _quote(output_dir + '/configDump.log') +
                  ' > ' + _quote(output_dir + '/configDump.py'),
                  suspend=False, verbose=(opts.verbosity > 0), dry_run=opts.dry_run)
    if retcode:
        EXE('cat ' + _quote(output_dir + '/configDump.log'),
            verbose=(opts.verbosity > 0), dry_run=opts.dry_run)
        raise SystemExit(retcode)

    subfile = output_dir + '/condor.sub'
    if not opts.dry_run:
        _write_condor_submit_file(subfile, output_dir, output_dir_final, opts, memory_mb, max_runtime_seconds)

    job_counter = 0
    total_events = 0
    stop = False

    for fdict in input_dset['files']:
        input_file = fdict['file']
        input_nevents = int(fdict['nevents'])

        secondary_files = []
        if opts.parentFiles_level == 1:
            secondary_files = fdict.get('parentFiles_1', [])
        elif opts.parentFiles_level == 2:
            secondary_files = fdict.get('parentFiles_2', [])

        if opts.parentFiles_level in (1, 2) and len(secondary_files) == 0:
            KILL(log_prx + 'secondary input files requested, but list is empty for ' + input_file)

        n_jobs_this_file = int(math.ceil(float(input_nevents) / opts.n_events)) if opts.n_events > 0 else 1
        remainder = input_nevents % opts.n_events if opts.n_events > 0 else 0

        for i_job in range(n_jobs_this_file):
            job_dir = output_dir + '/' + opts.jobdirname + output_postfix.format(job_counter)
            MKDIRP(job_dir + '/logs', verbose=(opts.verbosity > 0), dry_run=opts.dry_run)

            max_events_this_job = opts.n_events if opts.n_events > 0 else input_nevents
            if i_job == (n_jobs_this_file - 1) and remainder != 0:
                max_events_this_job = remainder

            total_events += max_events_this_job
            if opts.max_events > 0 and total_events >= opts.max_events:
                max_events_this_job -= (total_events - opts.max_events)
                stop = True

            if not opts.dry_run:
                open(job_dir + '/flag.queue', 'w').close()

            output_file = final_output.rstrip('/') + '/out' + output_postfix.format(job_counter) + '.root'
            cfg_rel = os.path.relpath(out_cfg, job_dir)
            skip_events = opts.n_events * i_job if opts.n_events > 0 else 0
            cmsrun_opts = _cmsrun_options(
                cfg_relpath=cfg_rel,
                max_events=max_events_this_job,
                skip_events=skip_events,
                input_file=input_file,
                secondary_files=secondary_files,
                output_file=output_file,
                extra_args=cmsrun_extra_args,
            )

            exe_path = job_dir + '/exe.sh'
            if not opts.dry_run:
                _write_job_executable(
                    path=exe_path,
                    cmssw_base=cmssw_base,
                    job_dir=job_dir,
                    cmsrun_opts=cmsrun_opts,
                    export_ld_library_path=opts.export_LD_LIBRARY_PATH,
                )

            print(colored_text('output:', ['1', '94']), os.path.relpath(exe_path, os.environ.get('PWD', os.getcwd())))
            job_counter += 1

            if stop:
                break
        if stop:
            break

    print(colored_text('prepared jobs:', ['1', '92']), job_counter)
    print(colored_text('submit file:', ['1', '92']), subfile)

    if opts.submit:
        EXE('condor_submit ' + _quote(subfile), suspend=False,
            verbose=(opts.verbosity > 0), dry_run=opts.dry_run)


if __name__ == '__main__':
    main()
